<?xml version="1.0" encoding="utf-8"?>
<!-- Android 7.x round icon: the logo tile on a disc of its navy (the adaptive background's colours). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="oval">
      <gradient android:angle="270" android:startColor="#272D66" android:endColor="#120E3B" />
    </shape>
  </item>
  <item android:drawable="@drawable/pardeh_logo" android:top="7dp" android:bottom="7dp" android:left="7dp" android:right="7dp" />
</layer-list>
