<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>false</UseWinUI>
    <AssemblyName>PardehWidgetProvider</AssemblyName>
    <RootNamespace>Pardeh.Widgets</RootNamespace>
    <SelfContained>false</SelfContained>
    <!-- Single-project MSIX: builds the package (with the Windows App SDK dependency) from Package.appxmanifest. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <GenerateTemporaryStoreCertificate>false</GenerateTemporaryStoreCertificate>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <Content Include="Images\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Public\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
