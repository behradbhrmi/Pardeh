<Project Sdk="Microsoft.NET.Sdk">

  <!-- Nava (melody, sound): Pardeh's audio. It knows nothing about pictures; see Pardeh.Nama for those. -->
  <PropertyGroup>
    <RootNamespace>Pardeh.Nava</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- net11.0: the desktop build (WASAPI + Media Foundation, Windows). net11.0-android: AudioTrack output. -->
    <TargetFramework />
    <TargetFrameworks>net11.0;net11.0-android</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.EndsWith('-android'))">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pardeh.Core\Pardeh.Core.csproj" />
    <ProjectReference Include="..\Pardeh.Ffmpeg\Pardeh.Ffmpeg.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <!-- NAudio.Core: ISampleProvider, DSP, wave formats (platform neutral). The full NAudio adds WASAPI and Media Foundation. -->
  <ItemGroup Condition="!$(TargetFramework.EndsWith('-android'))">
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.EndsWith('-android'))">
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
  </ItemGroup>

  <!-- Platform-specific files live in their own folders. -->
  <ItemGroup Condition="$(TargetFramework.EndsWith('-android'))">
    <Compile Remove="Windows\**" />
  </ItemGroup>
  <ItemGroup Condition="!$(TargetFramework.EndsWith('-android'))">
    <Compile Remove="Android\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pardeh.Engine" />
    <InternalsVisibleTo Include="Pardeh.Skinning.Tests" />
  </ItemGroup>

</Project>
